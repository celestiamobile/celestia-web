diff --git a/cmake/FindOpenGLES.cmake b/cmake/FindOpenGLES.cmake
index e909e3529..e326df91b 100644
--- a/cmake/FindOpenGLES.cmake
+++ b/cmake/FindOpenGLES.cmake
@@ -52,6 +52,30 @@ set(OpenGLES_ROOT_DIR
     "${OpenGLES_ROOT_DIR}"
     CACHE PATH "Root to search for OpenGLES")
 
+# On Emscripten, GLES is provided by the runtime - no library needed
+if(EMSCRIPTEN)
+    set(OpenGLES_FOUND TRUE)
+    foreach(_comp IN LISTS OpenGLES_FIND_COMPONENTS)
+        set(OpenGLES_${_comp}_FOUND TRUE)
+    endforeach()
+    if(NOT TARGET OpenGLES::OpenGLESv1)
+        add_library(OpenGLES::OpenGLESv1 INTERFACE IMPORTED)
+    endif()
+    if(NOT TARGET OpenGLES::OpenGLESv2)
+        add_library(OpenGLES::OpenGLESv2 INTERFACE IMPORTED)
+    endif()
+    if(NOT TARGET OpenGLES::OpenGLESv3)
+        add_library(OpenGLES::OpenGLESv3 INTERFACE IMPORTED)
+    endif()
+    if(NOT TARGET OpenGLES::OpenGLESv31)
+        add_library(OpenGLES::OpenGLESv31 INTERFACE IMPORTED)
+    endif()
+    if(NOT TARGET OpenGLES::OpenGLESv32)
+        add_library(OpenGLES::OpenGLESv32 INTERFACE IMPORTED)
+    endif()
+    return()
+endif()
+
 if(NOT OpenGLES_FIND_COMPONENTS)
     set(OpenGLES_FIND_COMPONENTS V2)
 endif()
